{
  "name": "vi-arc-cli",
  "version": "1.0.0",
  "description": "CLI tool for deploying Video Indexer Arc on Azure Kubernetes Service",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "vi-arc": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint src/",
    "test": "echo \"No tests yet\" && exit 0",
    "build": "pkg . --out-path dist",
    "build:win": "pkg . --targets node18-win-x64 --out-path dist",
    "build:linux": "pkg . --targets node18-linux-x64 --out-path dist",
    "build:mac": "pkg . --targets node18-macos-x64 --out-path dist",
    "build:all": "pkg . --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path dist"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": ["package.json"],
    "outputPath": "dist"
  },
  "keywords": [
    "azure",
    "video-indexer",
    "arc",
    "kubernetes",
    "aks",
    "cli"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "conf": "^12.0.0",
    "enquirer": "^2.4.1",
    "ora": "^8.0.1",
    "boxen": "^7.1.1",
    "cli-table3": "^0.6.5",
    "figures": "^6.1.0",
    "gradient-string": "^2.0.2",
    "listr2": "^8.2.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
